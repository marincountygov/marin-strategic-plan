{
  "name": "marin-strategic-plan",
  "version": "0.1.0",
  "private": true,
  "description": "The County of Marin's strategic plan as a JSON-LD/Schema.org-driven website, built on marin-site-template.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/generate-public-data.ts && tsx scripts/generate-search-index.ts",
    "preview": "serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:content": "tsx scripts/check-content.ts",
    "test:a11y": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run check:tokens && npm run check:content && npm run build && npm run test:a11y"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "serve": "^14.2.4",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
